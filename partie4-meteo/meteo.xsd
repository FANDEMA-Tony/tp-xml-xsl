<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <!-- Type simple : température en degrés Celsius, bornée -->
  <xs:simpleType name="TemperatureType">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="-60"/>
      <xs:maxInclusive value="60"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="meteo">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="mesure" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="ville" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="nom" type="xs:string" use="required"/>
                  <xs:attribute name="temperature" type="TemperatureType" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <!-- Vrai type date (AAAA-MM-JJ), impossible avec une DTD -->
            <xs:attribute name="date" type="xs:date" use="required"/>
          </xs:complexType>
          <!-- Une ville ne peut apparaître qu'une fois par mesure -->
          <xs:unique name="villeUniqueParMesure">
            <xs:selector xpath="ville"/>
            <xs:field xpath="@nom"/>
          </xs:unique>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <!-- Une seule mesure par date -->
    <xs:unique name="dateUnique">
      <xs:selector xpath="mesure"/>
      <xs:field xpath="@date"/>
    </xs:unique>
  </xs:element>
</xs:schema>
